#!/bin/bash
#
# Copyright, the authors of the Linux man-pages project
# SPDX-License-Identifier: GPL-3.0-or-later

set -Eeufo pipefail;

f="$(mktemp)";

cat >"$f";

{
	sed '/^Proposed/q' <"$f";

	sed -n '/^Proposed/,$p' <"$f" \
	| sed 's/^    /diff -- /' \
	| sed 's/^\t//' \
	| colordiff \
	| sed '/diff -- /s/^/    /' \
	| sed '/diff -- /!s/^/\t/' \
	| sed 's/diff -- //' \
	| tail -n+2;
} \
| ansi2html;
